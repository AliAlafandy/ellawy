function onGame()
{
    print("Ellawy script loaded successfully!");
    
    if PlayState.instance != null {
        print("PlayState is ready!");
    }
}
end

function onUpdate(elapsed:Float)
{
    if PlayState.instance != null and PlayState.instance.player != null {
        PlayState.instance.player.angle += 100 * elapsed;
    }
}
end
